{# Debian switches PHP's own session cleanup off and leaves it to a cron job, which the image does not run.
   Without it, expired sessions are never removed: they fill their tmpfs, and Passbolt's session timeout,
   which is PHP's `session.gc_maxlifetime`, never takes effect. These are PHP's own defaults. #}
session.gc_probability = 1
session.gc_divisor = 100
