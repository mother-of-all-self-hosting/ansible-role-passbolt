[Unit]
Description=Passbolt ({{ passbolt_identifier }})
{% for service in passbolt_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in passbolt_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ passbolt_container_cleanup_command | trim | replace("\n", " ") }}'

{#
  The paths the image writes to belong to its own www-data user. Each of them gets a tmpfs owned by
  `passbolt_uid` (Docker would otherwise copy the image directory's owner onto it): the GnuPG keyring
  (re-imported from `passbolt_data_path` on every start), the self-signed certificate for nginx's unused
  HTTPS port, PHP's sessions and the logs that do not go to stdout.

  nginx's global logs go to /dev/null instead, as a tmpfs over /var/log/nginx would hide the image's
  symlinks which send Passbolt's own nginx logs to stdout and stderr.

  The image dumps its environment into /etc/environment on every start, so that CLI commands run with
  `docker exec` can source it for the server key fingerprint it detects. Its own copy is not writable
  by `passbolt_uid`, so a file under `passbolt_base_path` takes its place.
#}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ passbolt_identifier }} \
      --log-driver=none \
      --user={{ passbolt_uid }}:{{ passbolt_gid }} \
      --group-add={{ passbolt_container_image_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ passbolt_container_network }} \
      {% if passbolt_container_http_host_bind_port %}
      -p {{ passbolt_container_http_host_bind_port }}:{{ passbolt_container_http_port }} \
      {% endif %}
      --env-file={{ passbolt_base_path }}/env \
      --label-file={{ passbolt_base_path }}/labels \
      --mount type=bind,src={{ passbolt_base_path }}/passwd,dst=/etc/passwd,ro \
      --mount type=bind,src={{ passbolt_base_path }}/php.ini,dst=/etc/passbolt-php/passbolt.ini,ro \
      --mount type=bind,src={{ passbolt_base_path }}/etc-environment,dst=/etc/environment \
      --mount type=bind,src={{ passbolt_data_path }}/gpg,dst=/etc/passbolt/gpg \
      --mount type=bind,src={{ passbolt_data_path }}/jwt,dst=/etc/passbolt/jwt \
      --mount type=bind,src=/dev/null,dst=/var/log/nginx/access.log \
      --mount type=bind,src=/dev/null,dst=/var/log/nginx/error.log \
      {% if passbolt_database_type == 'mysql' and passbolt_database_mysql_socket_enabled and passbolt_database_mysql_socket_path_host != '' %}
      --mount type=bind,src={{ passbolt_database_mysql_socket_path_host }},dst={{ passbolt_database_mysql_socket_path_container }} \
      {% endif %}
      {% if passbolt_database_type == 'postgres' and passbolt_database_postgres_socket_enabled and passbolt_database_postgres_socket_path_host != '' %}
      --mount type=bind,src={{ passbolt_database_postgres_socket_path_host }},dst={{ passbolt_database_postgres_socket_path_container }} \
      {% endif %}
      {% for volume in passbolt_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_tmp_size }} \
      --tmpfs=/var/lib/passbolt/tmp:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_cache_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      --tmpfs=/var/lib/passbolt/.gnupg:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_gnupg_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      --tmpfs=/etc/passbolt/certs:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_certs_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      --tmpfs=/var/lib/php/sessions:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_sessions_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      --tmpfs=/var/log/passbolt:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_log_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      --tmpfs=/var/log/supervisor:rw,noexec,nosuid,size={{ passbolt_container_tmpfs_supervisor_size }},mode=0700,uid={{ passbolt_uid }},gid={{ passbolt_gid }} \
      {% for arg in passbolt_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ passbolt_container_image }} \
      {% for arg in passbolt_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% for network in passbolt_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ passbolt_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ passbolt_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ passbolt_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ passbolt_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ passbolt_identifier }}

[Install]
WantedBy=multi-user.target
