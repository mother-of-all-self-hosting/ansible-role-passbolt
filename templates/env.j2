TZ={{ passbolt_environment_variables_tz }}

APP_FULL_BASE_URL={{ passbolt_environment_variables_app_full_base_url }}

{% if passbolt_environment_variables_https %}
HTTPS={{ passbolt_environment_variables_https }}
{% endif %}

PASSBOLT_SSL_FORCE={{ passbolt_environment_variables_passbolt_ssl_force | bool | to_json }}

PASSBOLT_SECURITY_PROXIES_ACTIVE={{ passbolt_environment_variables_passbolt_security_proxies_active | bool | to_json }}

LOG_DEBUG_URL={{ passbolt_environment_variables_log_debug_url }}

{# PHP's own session cleanup, which the image switches off (see `php.ini.j2`). #}
PHP_INI_SCAN_DIR=:/etc/passbolt-php

{% if passbolt_database_type == 'mysql' %}
DATASOURCES_DEFAULT_DRIVER=Cake\Database\Driver\Mysql
{% if passbolt_database_mysql_socket_enabled %}
DATASOURCES_DEFAULT_URL={{ passbolt_environment_variables_datasources_default_url_mysql }}
{% else %}
DATASOURCES_DEFAULT_HOST={{ passbolt_database_mysql_hostname }}
DATASOURCES_DEFAULT_PORT={{ passbolt_database_mysql_port }}
{% endif %}
DATASOURCES_DEFAULT_USERNAME={{ passbolt_database_mysql_username }}
DATASOURCES_DEFAULT_PASSWORD={{ passbolt_database_mysql_password }}
DATASOURCES_DEFAULT_ENCODING=utf8mb4
{% endif %}
{% if passbolt_database_type == 'postgres' %}
DATASOURCES_DEFAULT_DRIVER=Cake\Database\Driver\Postgres
DATASOURCES_DEFAULT_HOST={{ passbolt_environment_variables_datasources_default_host_postgres }}
DATASOURCES_DEFAULT_PORT={{ passbolt_database_postgres_port }}
DATASOURCES_DEFAULT_USERNAME={{ passbolt_database_postgres_username }}
DATASOURCES_DEFAULT_PASSWORD={{ passbolt_database_postgres_password }}
DATASOURCES_DEFAULT_ENCODING=utf8
{% endif %}
DATASOURCES_DEFAULT_DATABASE={{ passbolt_database_name }}

{% if passbolt_environment_variables_email_default_from %}
EMAIL_DEFAULT_FROM={{ passbolt_environment_variables_email_default_from }}
{% endif %}
EMAIL_DEFAULT_FROM_NAME={{ passbolt_environment_variables_email_default_from_name }}
{% if passbolt_environment_variables_email_transport_default_host %}
EMAIL_TRANSPORT_DEFAULT_HOST={{ passbolt_environment_variables_email_transport_default_host }}
EMAIL_TRANSPORT_DEFAULT_PORT={{ passbolt_environment_variables_email_transport_default_port }}
EMAIL_TRANSPORT_DEFAULT_USERNAME={{ passbolt_environment_variables_email_transport_default_username }}
EMAIL_TRANSPORT_DEFAULT_PASSWORD={{ passbolt_environment_variables_email_transport_default_password }}
{# Passbolt enables STARTTLS for any non-empty value, `false` included, and an `ssl://` host
   already connects with implicit TLS, which STARTTLS would break. #}
{% if passbolt_environment_variables_email_transport_default_tls | bool and not passbolt_environment_variables_email_transport_default_host.startswith('ssl://') %}
EMAIL_TRANSPORT_DEFAULT_TLS=true
{% endif %}
{% endif %}

{{ passbolt_environment_variables_additional_variables }}
